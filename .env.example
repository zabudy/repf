PROJECT_NAME=REPF
DEBUG=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./repf.db
WORKER_MODE=local
HITL_ENABLED=true
CONFIDENCE_THRESHOLD=0.6
MAX_ITERATIONS=3

# Значения ниже задают настройки сервера. Личные пресеты создаются в UI.
# auto: с COMPATIBLE_LLM_URL общий ключ используется для этого API, иначе для DeepSeek.
# mock: детерминированный режим для демонстрации и тестов.
LLM_PROVIDER=auto
LLM_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
# COMPATIBLE_LLM_URL=http://127.0.0.1:8001/v1
COMPATIBLE_LLM_MODEL=qwen2.5
LLM_TIMEOUT=18

# Настройте для Docker. Локально пустое значение даёт временный ключ.
JWT_SECRET_KEY=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
JWT_EXPIRATION_MINUTES=480
# POSTGRES_PASSWORD=
# QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=repf_cases_v1
REDIS_URL=redis://127.0.0.1:6379/0
